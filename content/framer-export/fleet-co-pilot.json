    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Surveyed how autonomous-fleet operators actually run this today:"
    },
    {
      "kind": "list",
      "items": [
        "Route/dispatch optimization and predictive maintenance",
        "Multi-vendor AV monitoring and safety-driver incident apps",
        "Operational exposure analysis and edge-case/video tagging"

    {
      "kind": "text",
      "tag": "h6",
      "text": "Competitor Analysis"
    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Analyzed spatial learning and tutorial platforms (e.g., JigSpace, WikiHow VR, YouTube with AR extensions)."
    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Identified gaps in interactive guidance, spatial UX fidelity, and lack of cross-context template systems for different task types (DIY, cooking, tech repair)."
    },
    {
      "kind": "component",
      "name": "Dot Slider",
      "controls": {
        "dot1": "true",
        "dot2": "true",
        "dot3": "true",
        "dot4": "true",
        "dot5": "false"
      }
    },
    {
      "kind": "text",
      "tag": "h6",
      "text": "User Interviews"
    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Interviewed 9 participants (ages 20–45) who regularly engage with instructional content online (YouTube, blogs, mobile apps)."
    },
    {
      "kind": "list",
      "items": [
        "7/9 struggle to pause / switch between content and task",
        "6/9 expressed interest in hands-free visual instruction",
        "5/9 found current AR tools either non-intuitive or overly complex"
      ]
    },
    {
      "kind": "component",
      "name": "Dot Slider",
      "controls": {
        "dot1": "true",
        "dot2": "true",
        "dot3": "true",
        "dot4": "true",
        "dot5": "false"
      }
    },
    {
      "kind": "text",
      "tag": "h6",
      "text": "Persona Building"
    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Constructed 3 personas from interview data:"
    },
    {
      "kind": "list",
      "items": [
        "DIY Dan: 32, uses YouTube for repairs, needs visual clarity",
        "Chef Lila: 28, uses Instagram Reels for recipes, wants step control",
        "Tinker Tim: 24, builds PCs, frustrated with switching apps during work"
      ]
    },
    {
      "kind": "component",
      "name": "Dot Slider",
      "controls": {

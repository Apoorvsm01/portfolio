    {
      "kind": "text",
      "tag": "h6",
      "text": "Brainstorming Sessions"
    },
    {
      "kind": "text",
      "tag": "p",
      "text": "Held 5 internal sessions to ideate onboarding flows, spatial interactions, and modular templates (e.g., stove/oven marker for cooking, screw guide for repair)."
    },
    {
      "kind": "component",
      "name": "Dot Slider",
      "controls": {
        "dot1": "true",

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jd-fetch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Optional per-IP limiter (Workers Rate Limiting API). If this binding is missing the Worker
  // falls back to a best-effort in-memory limiter. period must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
